# Dependencies
node_modules/
.pnp.*

# Build output
dist/
build/
coverage/
*.tsbuildinfo

# Environment files (never commit secrets)
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# AI images, trained models and generated reports (large, and photos may be personal)
services/ai/data/*
!services/ai/data/README.md
services/ai/models/*
!services/ai/models/.gitkeep
services/ai/reports/
.ruff_cache/

# Uploaded files
apps/api/uploads/*
!apps/api/uploads/.gitkeep

# Editor and OS files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# Generated Prisma client (re-created with "npm run db:generate")
apps/api/src/generated/
