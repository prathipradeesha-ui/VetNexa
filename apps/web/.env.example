# Copy to apps/web/.env.local for local development (never commit real keys).

# Optional Google Maps JavaScript API browser key. Create it in Google Cloud Console:
# APIs & Services → enable "Maps JavaScript API" → Credentials → API key, and restrict it to
# HTTP referrers such as http://localhost:5173/* and your domain. Without a key, maps use
# Google's keyless embed and show one place at a time.
VITE_GOOGLE_MAPS_API_KEY=

# Optional map ID for advanced markers; Google's DEMO_MAP_ID is used when empty.
VITE_GOOGLE_MAPS_MAP_ID=
