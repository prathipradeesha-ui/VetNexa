# Copy this file to .env and adjust the values for your machine.

# MySQL connection used by Prisma (matches the db service in docker-compose.yml).
DATABASE_URL="mysql://vetnexa:vetnexa_dev_password@localhost:3307/vetnexa"

# API server
NODE_ENV=development
PORT=4100
# Front-end origins allowed to call the API (comma-separated)
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Authentication
# Generate your own with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
SESSION_HOURS=12

# Photo storage: "local" (apps/api/uploads) or "s3" (MinIO from docker compose up -d minio).
STORAGE_DRIVER=local
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=vetnexa-uploads
# S3_ACCESS_KEY_ID=vetnexa
# S3_SECRET_ACCESS_KEY=change-me-minio-password

# Internal AI inference service (python -m vetnexa_ai.service in services/ai)
AI_SERVICE_URL=http://127.0.0.1:8000
# Optional shared secret; must match VETNEXA_AI_TOKEN of the AI service when set
AI_SERVICE_TOKEN=
