# Copy this file to .env and adjust the values for your machine.

# MySQL connection used by Prisma (matches the db service in docker-compose.yml).
DATABASE_URL="mysql://vetnexa:vetnexa_dev_password@localhost:3307/vetnexa"

# API server
NODE_ENV=development
PORT=4100
# Front-end origins allowed to call the API (comma-separated)
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
