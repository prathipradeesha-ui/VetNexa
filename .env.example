# Settings for `docker compose` (copy to .env; never commit the real file).

# ── Web ──
# Address people use to open VetNexa (used for CORS). Change when deploying behind a domain.
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080

# ── Database ──
MYSQL_DATABASE=vetnexa
MYSQL_USER=vetnexa
MYSQL_PASSWORD=change-me-database-password
MYSQL_ROOT_PASSWORD=change-me-root-password
# Host port for MySQL, for local development tools only.
MYSQL_PORT=3307

# ── API ──
# Required. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SESSION_HOURS=12
LOG_LEVEL=info

# ── AI service ──
# Shared secret between the API and the AI service (recommended); Compose passes it to both.
AI_SERVICE_TOKEN=
